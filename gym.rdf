    <owl:Ontology rdf:about="http://www.semanticweb.org/nouman/ontologies/2026/4/gym-fitness">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/nouman/ontologies/2026/4/gym-fitness/2.0"/>
        <rdfs:comment xml:lang="en">An OWL 2 ontology modelling gyms, members, trainers, workout plans, exercises, equipment, diet plans, supplements, health records, and fitness goals.</rdfs:comment>
        <rdfs:label xml:lang="en">Gym and Fitness Ontology</rdfs:label>
    </owl:Ontology>
    


