    <owl:Ontology rdf:about="http://www.semanticweb.org/nouman/ontologies/2026/4/gym-fitness">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/nouman/ontologies/2026/4/gym-fitness/2.0"/>
